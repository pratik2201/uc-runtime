{
  "include": [
    "src"
  ], 
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declarationDir": "dist", 
    "baseUrl": ".",
    "sourceMap": true,
    "allowJs": true,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "checkJs": false,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "removeComments": false,
    "noImplicitAny": false,
    "inlineSources": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "stripInternal": true,
    "skipLibCheck": true,
    "paths": {
      "uc-runtime/*": ["./*"]
    },
  }
  // "references": [
  //   { "path": "../ap-shared-core" }
  // ]
}
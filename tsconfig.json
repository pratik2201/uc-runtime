{
  "include": [
    "src"
   ],
  "exclude": [
    "out",
    "node_modules"
  ],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "rootDir": "src",
    "outDir": "out",
    "baseUrl": ".",
    "declaration": true,
    "sourceMap": true,
    "allowJs": true,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "checkJs": false,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "skipLibCheck": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "removeComments": false,
    "noImplicitAny": false,
    "inlineSources": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "paths": {
      "uc-runtime/*": [
        "./*"
      ],
      "ap-shared-core/*": [
        "../ap-shared-core/*"
      ],
    }
  }
}
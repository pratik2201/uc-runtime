{
  "include": [ "src"  ],
  "exclude": [ "node_modules", "out","types" ],
  "compilerOptions": {
     "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "baseUrl": ".",
    "outDir": "out",   
    "rootDir": "src",       
   
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "allowJs": true,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "checkJs": false,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "skipLibCheck": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "removeComments": false,
    "noImplicitAny": false,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "paths": {
      "ucbuilder/*": [ "./src/*"  ],
      "@ucbuilder/*": [  "./src/*"  ]
    }
  }
}
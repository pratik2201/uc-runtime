{
  "include": [
    "src","src/main/resstorage.d.ts"
  ],
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "sourceMap": true, 
    "strictNullChecks": false,
    
    "esModuleInterop": true,
    "checkJs": false,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "removeComments": false,
    "noImplicitAny": false,
    "inlineSources": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "stripInternal": true,
    "skipLibCheck": true,
     
    "paths": {
      "ap-shared-core/*": [
        "./node_modules/ap-shared-core/out/*"
      ],
      
      "uc-runtime/*": [
        "./src/*"
      ]
    }
  },
}